{
  "format": "chendoom-workflow-plan",
  "schemaVersion": 1,
  "plan": {
    "id": "group-trip",
    "version": "11",
    "name": "Group Trip",
    "description": "Suggest destinations, choose a most-suggested destination, then record and split trip expenses with booking links close at hand.",
    "roles": [
      {
        "id": "organizer",
        "name": "Trip Organizer",
        "assignmentCardinality": "exactlyOne",
        "startsPlan": true
      },
      {
        "id": "participant",
        "name": "Traveller",
        "assignmentCardinality": "oneOrMore",
        "startsPlan": false
      }
    ],
    "people": {
      "description": "Travellers are participant records, separate from app roles. An organiser can suggest a destination or record an expense for a traveller without an app account."
    },
    "workflows": [
      {
        "id": "proposal",
        "definitionId": "trip-proposal",
        "definitionVersion": "14",
        "creationEventId": "propose-trip",
        "launch": "automatic",
        "roleBindings": [
          {
            "planRoleId": "organizer",
            "workflowRoleId": "organizer"
          },
          {
            "planRoleId": "participant",
            "workflowRoleId": "participant"
          }
        ]
      },
      {
        "id": "expenses",
        "definitionId": "trip-expenses",
        "definitionVersion": "14",
        "creationEventId": "start-trip-at-destination",
        "launch": "automatic",
        "after": [
          "proposal"
        ],
        "roleBindings": [
          {
            "planRoleId": "organizer",
            "workflowRoleId": "organizer"
          },
          {
            "planRoleId": "participant",
            "workflowRoleId": "recorder"
          }
        ],
        "inputBindings": [
          {
            "completedWorkflow": "proposal",
            "field": "tripName",
            "workflowInput": "tripName"
          },
          {
            "completedWorkflow": "proposal",
            "field": "currency",
            "workflowInput": "currency"
          },
          {
            "completedWorkflow": "proposal",
            "field": "participants",
            "workflowInput": "participants"
          },
          {
            "completedWorkflow": "proposal",
            "field": "chosenDestination",
            "workflowInput": "chosenDestination"
          }
        ]
      }
    ]
  }
}
