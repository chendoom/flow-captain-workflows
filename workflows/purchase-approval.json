{
  "$schema": "../schemas/workflow-v3.schema.json",
  "format": "chendoom-workflow",
  "schemaVersion": 3,
  "workflow": {
    "name": "Purchase Approval",
    "description": "Submit a proposed purchase for approval, rejection, or requested changes.",
    "roles": [
      {
        "id": "requester",
        "name": "Requester",
        "cardinality": "one",
        "startsWorkflow": true
      },
      {
        "id": "approver",
        "name": "Approver",
        "cardinality": "one"
      },
      {
        "id": "observer",
        "name": "Observer",
        "cardinality": "one-or-more",
        "isObserver": true
      }
    ],
    "data": [
      {
        "id": "purchase",
        "name": "Purchase",
        "type": "text",
        "requiredAtStart": true
      },
      {
        "id": "estimated-cost",
        "name": "Estimated Cost",
        "type": "decimal",
        "requiredAtStart": true
      },
      {
        "id": "business-reason",
        "name": "Reason",
        "type": "text",
        "requiredAtStart": true
      },
      {
        "id": "approver-feedback",
        "name": "Approver Feedback",
        "type": "text"
      },
      {
        "id": "quote-link",
        "name": "Product or Quote Link",
        "type": "link"
      },
      {
        "id": "currency",
        "name": "Currency",
        "type": "currency",
        "requiredAtStart": true
      }
    ],
    "states": [
      {
        "id": "awaiting-approval",
        "name": "Awaiting Approval"
      },
      {
        "id": "changes-requested",
        "name": "Changes Requested"
      },
      {
        "id": "approved",
        "name": "Approved",
        "terminal": true,
        "outcome": "successful"
      },
      {
        "id": "rejected",
        "name": "Rejected",
        "terminal": true,
        "outcome": "unsuccessful"
      }
    ],
    "actions": [
      {
        "id": "submit-purchase",
        "name": "Submit Purchase",
        "payload": [
          {
            "id": "purchase",
            "name": "Purchase",
            "domainField": "purchase"
          },
          {
            "id": "estimated-cost",
            "name": "Estimated Cost",
            "domainField": "estimated-cost"
          },
          {
            "id": "business-reason",
            "name": "Reason",
            "domainField": "business-reason"
          },
          {
            "id": "currency",
            "name": "Currency",
            "domainField": "currency"
          }
        ],
        "paths": [
          {
            "id": "submit-purchase-path",
            "from": "start",
            "role": "requester",
            "to": "awaiting-approval",
            "updates": [
              {
                "kind": "copy-input",
                "output": "purchase",
                "input": "purchase"
              },
              {
                "kind": "copy-input",
                "output": "estimated-cost",
                "input": "estimated-cost"
              },
              {
                "kind": "copy-input",
                "output": "business-reason",
                "input": "business-reason"
              },
              {
                "kind": "copy-input",
                "output": "currency",
                "input": "currency"
              }
            ]
          }
        ]
      },
      {
        "id": "approve-purchase",
        "name": "Approve",
        "paths": [
          {
            "id": "approve-purchase-path",
            "from": "awaiting-approval",
            "role": "approver",
            "to": "approved",
            "order": 1
          }
        ]
      },
      {
        "id": "request-purchase-changes",
        "name": "Request Changes",
        "payload": [
          {
            "id": "change-feedback",
            "name": "Feedback",
            "domainField": "approver-feedback"
          }
        ],
        "paths": [
          {
            "id": "request-purchase-changes-path",
            "from": "awaiting-approval",
            "role": "approver",
            "to": "changes-requested",
            "order": 2,
            "updates": [
              {
                "kind": "copy-input",
                "output": "approver-feedback",
                "input": "change-feedback"
              }
            ]
          }
        ]
      },
      {
        "id": "reject-purchase",
        "name": "Reject",
        "paths": [
          {
            "id": "reject-purchase-path",
            "from": "awaiting-approval",
            "role": "approver",
            "to": "rejected",
            "order": 3,
            "emphasis": "destructive",
            "updates": [
              {
                "kind": "copy-input",
                "output": "approver-feedback",
                "input": "approver-feedback"
              }
            ]
          }
        ],
        "payload": [
          {
            "id": "approver-feedback",
            "name": "Reason for Rejection",
            "domainField": "approver-feedback"
          }
        ]
      },
      {
        "id": "resubmit-purchase",
        "name": "Resubmit",
        "payload": [
          {
            "id": "revised-cost",
            "name": "Estimated Cost",
            "domainField": "estimated-cost"
          },
          {
            "id": "revised-reason",
            "name": "Reason",
            "domainField": "business-reason"
          },
          {
            "id": "currency",
            "name": "Currency",
            "domainField": "currency"
          }
        ],
        "paths": [
          {
            "id": "resubmit-purchase-path",
            "from": "changes-requested",
            "role": "requester",
            "to": "awaiting-approval",
            "updates": [
              {
                "kind": "copy-input",
                "output": "estimated-cost",
                "input": "revised-cost"
              },
              {
                "kind": "copy-input",
                "output": "business-reason",
                "input": "revised-reason"
              },
              {
                "kind": "copy-input",
                "output": "currency",
                "input": "currency"
              }
            ]
          }
        ]
      },
      {
        "id": "set-quote-link",
        "name": "Add or Update Product or Quote Link",
        "payload": [
          {
            "id": "quote-link",
            "name": "Product or Quote Link",
            "domainField": "quote-link"
          }
        ],
        "paths": [
          {
            "id": "set-quote-link-awaiting-approval",
            "from": "awaiting-approval",
            "role": "requester",
            "to": "awaiting-approval",
            "order": 10,
            "updates": [
              {
                "kind": "copy-input",
                "output": "quote-link",
                "input": "quote-link"
              }
            ]
          },
          {
            "id": "set-quote-link-changes-requested",
            "from": "changes-requested",
            "role": "requester",
            "to": "changes-requested",
            "order": 10,
            "updates": [
              {
                "kind": "copy-input",
                "output": "quote-link",
                "input": "quote-link"
              }
            ]
          }
        ]
      }
    ],
    "presentation": {
      "workflowData": {
        "prominentFields": [
          "purchase",
          "estimated-cost",
          "currency"
        ],
        "hiddenFields": [
          "business-reason"
        ]
      }
    }
  }
}
