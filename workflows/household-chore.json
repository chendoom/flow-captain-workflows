{
  "$schema": "../schemas/workflow-v5.schema.json",
  "format": "chendoom-workflow",
  "schemaVersion": 5,
  "workflow": {
    "name": "Household Chore",
    "description": "Choose a household chore from a defined list, check the result, and request another attempt when needed.",
    "roles": [
      {
        "id": "organizer",
        "name": "Organizer",
        "cardinality": "one",
        "startsWorkflow": true
      },
      {
        "id": "helper",
        "name": "Helper",
        "cardinality": "one"
      },
      {
        "id": "observer",
        "name": "Observer",
        "cardinality": "one-or-more",
        "isObserver": true
      }
    ],
    "data": [
      {
        "id": "task",
        "name": "Chore",
        "type": "choice",
        "requiredAtStart": true,
        "choices": [
          {
            "id": "vacuum",
            "label": "Vacuum"
          },
          {
            "id": "wash-dishes",
            "label": "Wash dishes"
          },
          {
            "id": "take-bins-out",
            "label": "Take bins out"
          }
        ]
      },
      {
        "id": "retry-feedback",
        "name": "What Needs Changing",
        "type": "text"
      }
    ],
    "states": [
      {
        "id": "assigned",
        "name": "Assigned"
      },
      {
        "id": "ready-to-check",
        "name": "Ready to Check"
      },
      {
        "id": "complete",
        "name": "Complete",
        "terminal": true,
        "outcome": "successful"
      }
    ],
    "actions": [
      {
        "id": "assign",
        "name": "Assign",
        "payload": [
          {
            "id": "task",
            "name": "Chore",
            "domainField": "task"
          }
        ],
        "paths": [
          {
            "id": "assign-task",
            "from": "start",
            "role": "organizer",
            "to": "assigned",
            "updates": [
              {
                "kind": "copy-input",
                "output": "task",
                "input": "task"
              }
            ]
          }
        ]
      },
      {
        "id": "mark-done",
        "name": "Mark Done",
        "paths": [
          {
            "id": "mark-task-done",
            "from": "assigned",
            "role": "helper",
            "to": "ready-to-check"
          }
        ]
      },
      {
        "id": "approve",
        "name": "Approve",
        "paths": [
          {
            "id": "approve-task",
            "from": "ready-to-check",
            "role": "organizer",
            "to": "complete",
            "order": 1
          }
        ]
      },
      {
        "id": "try-again",
        "name": "Try Again",
        "paths": [
          {
            "id": "retry-task",
            "from": "ready-to-check",
            "role": "organizer",
            "to": "assigned",
            "order": 2,
            "updates": [
              {
                "kind": "copy-input",
                "output": "retry-feedback",
                "input": "retry-feedback"
              }
            ]
          }
        ],
        "payload": [
          {
            "id": "retry-feedback",
            "name": "What Needs Changing",
            "domainField": "retry-feedback"
          }
        ]
      }
    ],
    "presentation": {
      "workflowData": {
        "prominentFields": [
          "task"
        ],
        "fieldRules": {
          "retry-feedback": {
            "hideWhenEmpty": true,
            "visibleStates": [
              "assigned",
              "ready-to-check"
            ]
          }
        }
      }
    }
  }
}
