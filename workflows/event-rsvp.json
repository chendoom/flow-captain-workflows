{
  "$schema": "../schemas/workflow-v3.schema.json",
  "format": "chendoom-workflow",
  "schemaVersion": 3,
  "workflow": {
    "name": "Event RSVP",
    "description": "Invite one guest, collect their response, and acknowledge the final answer.",
    "roles": [
      {
        "id": "organizer",
        "name": "Organizer",
        "cardinality": "one",
        "startsWorkflow": true
      },
      {
        "id": "guest",
        "name": "Guest",
        "cardinality": "one"
      }
    ],
    "data": [
      {
        "id": "event",
        "name": "Event",
        "type": "text",
        "requiredAtStart": true
      },
      {
        "id": "event-time",
        "name": "Event Time",
        "type": "date-time",
        "requiredAtStart": true
      },
      {
        "id": "location",
        "name": "Location",
        "type": "text",
        "requiredAtStart": true
      },
      {
        "id": "event-link",
        "name": "Event or Map Link",
        "type": "link"
      }
    ],
    "states": [
      {
        "id": "awaiting-response",
        "name": "Awaiting Response"
      },
      {
        "id": "attending",
        "name": "Attending"
      },
      {
        "id": "not-attending",
        "name": "Not Attending"
      },
      {
        "id": "confirmed",
        "name": "Confirmed",
        "terminal": true,
        "outcome": "successful"
      },
      {
        "id": "declined",
        "name": "Declined",
        "terminal": true,
        "outcome": "neutral"
      }
    ],
    "actions": [
      {
        "id": "send-invitation",
        "name": "Send Invitation",
        "payload": [
          {
            "id": "event",
            "name": "Event",
            "domainField": "event"
          },
          {
            "id": "event-time",
            "name": "Event Time",
            "domainField": "event-time"
          },
          {
            "id": "location",
            "name": "Location",
            "domainField": "location"
          }
        ],
        "paths": [
          {
            "id": "send-invitation-path",
            "from": "start",
            "role": "organizer",
            "to": "awaiting-response",
            "updates": [
              {
                "kind": "copy-input",
                "output": "event",
                "input": "event"
              },
              {
                "kind": "copy-input",
                "output": "event-time",
                "input": "event-time"
              },
              {
                "kind": "copy-input",
                "output": "location",
                "input": "location"
              }
            ]
          }
        ]
      },
      {
        "id": "accept-invitation",
        "name": "Accept",
        "paths": [
          {
            "id": "accept-invitation-path",
            "from": "awaiting-response",
            "role": "guest",
            "to": "attending",
            "order": 1
          }
        ]
      },
      {
        "id": "decline-invitation",
        "name": "Decline",
        "paths": [
          {
            "id": "decline-invitation-path",
            "from": "awaiting-response",
            "role": "guest",
            "to": "not-attending",
            "order": 2,
            "emphasis": "destructive"
          }
        ]
      },
      {
        "id": "acknowledge-acceptance",
        "name": "Confirm Attendance",
        "paths": [
          {
            "id": "acknowledge-acceptance-path",
            "from": "attending",
            "role": "organizer",
            "to": "confirmed"
          }
        ]
      },
      {
        "id": "acknowledge-decline",
        "name": "Acknowledge Decline",
        "paths": [
          {
            "id": "acknowledge-decline-path",
            "from": "not-attending",
            "role": "organizer",
            "to": "declined"
          }
        ]
      },
      {
        "id": "set-event-link",
        "name": "Add or Update Event or Map Link",
        "payload": [
          {
            "id": "event-link",
            "name": "Event or Map Link",
            "domainField": "event-link"
          }
        ],
        "paths": [
          {
            "id": "set-event-link-awaiting-response",
            "from": "awaiting-response",
            "role": "organizer",
            "to": "awaiting-response",
            "order": 10,
            "updates": [
              {
                "kind": "copy-input",
                "output": "event-link",
                "input": "event-link"
              }
            ]
          },
          {
            "id": "set-event-link-attending",
            "from": "attending",
            "role": "organizer",
            "to": "attending",
            "order": 10,
            "updates": [
              {
                "kind": "copy-input",
                "output": "event-link",
                "input": "event-link"
              }
            ]
          },
          {
            "id": "set-event-link-not-attending",
            "from": "not-attending",
            "role": "organizer",
            "to": "not-attending",
            "order": 10,
            "updates": [
              {
                "kind": "copy-input",
                "output": "event-link",
                "input": "event-link"
              }
            ]
          }
        ]
      }
    ],
    "presentation": {
      "workflowData": {
        "prominentFields": [
          "event",
          "event-time"
        ]
      }
    }
  }
}
