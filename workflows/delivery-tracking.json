{
  "$schema": "../schemas/workflow-v3.schema.json",
  "format": "chendoom-workflow",
  "schemaVersion": 3,
  "workflow": {
    "name": "Delivery Tracking",
    "description": "Follow a delivery from dispatch through collection and confirmed receipt.",
    "roles": [
      {
        "id": "sender",
        "name": "Sender",
        "cardinality": "one",
        "startsWorkflow": true
      },
      {
        "id": "courier",
        "name": "Courier",
        "cardinality": "one"
      },
      {
        "id": "recipient",
        "name": "Recipient",
        "cardinality": "one"
      }
    ],
    "data": [
      {
        "id": "parcel",
        "name": "Parcel",
        "type": "text",
        "requiredAtStart": true
      },
      {
        "id": "tracking-reference",
        "name": "Tracking Reference",
        "type": "text",
        "requiredAtStart": true
      },
      {
        "id": "expected-by",
        "name": "Expected By",
        "type": "date-time",
        "requiredAtStart": true
      },
      {
        "id": "tracking-link",
        "name": "Tracking Link",
        "type": "link"
      },
      {
        "id": "problem-details",
        "name": "Problem Details",
        "type": "text"
      }
    ],
    "states": [
      {
        "id": "awaiting-collection",
        "name": "Awaiting Collection"
      },
      {
        "id": "in-transit",
        "name": "In Transit"
      },
      {
        "id": "delivered",
        "name": "Delivered"
      },
      {
        "id": "received",
        "name": "Received",
        "terminal": true,
        "outcome": "successful"
      },
      {
        "id": "problem-reported",
        "name": "Problem Reported",
        "terminal": true,
        "outcome": "unsuccessful"
      }
    ],
    "actions": [
      {
        "id": "dispatch",
        "name": "Dispatch",
        "payload": [
          {
            "id": "parcel",
            "name": "Parcel",
            "domainField": "parcel"
          },
          {
            "id": "tracking-reference",
            "name": "Tracking Reference",
            "domainField": "tracking-reference"
          },
          {
            "id": "expected-by",
            "name": "Expected By",
            "domainField": "expected-by"
          }
        ],
        "paths": [
          {
            "id": "dispatch-path",
            "from": "start",
            "role": "sender",
            "to": "awaiting-collection",
            "updates": [
              {
                "kind": "copy-input",
                "output": "parcel",
                "input": "parcel"
              },
              {
                "kind": "copy-input",
                "output": "tracking-reference",
                "input": "tracking-reference"
              },
              {
                "kind": "copy-input",
                "output": "expected-by",
                "input": "expected-by"
              }
            ]
          }
        ]
      },
      {
        "id": "collect-parcel",
        "name": "Collect Parcel",
        "paths": [
          {
            "id": "collect-parcel-path",
            "from": "awaiting-collection",
            "role": "courier",
            "to": "in-transit"
          }
        ]
      },
      {
        "id": "mark-delivered",
        "name": "Mark Delivered",
        "paths": [
          {
            "id": "mark-delivered-path",
            "from": "in-transit",
            "role": "courier",
            "to": "delivered"
          }
        ]
      },
      {
        "id": "confirm-receipt",
        "name": "Confirm Receipt",
        "paths": [
          {
            "id": "confirm-receipt-path",
            "from": "delivered",
            "role": "recipient",
            "to": "received",
            "order": 1
          }
        ]
      },
      {
        "id": "report-delivery-problem",
        "name": "Report Problem",
        "paths": [
          {
            "id": "report-delivery-problem-path",
            "from": "delivered",
            "role": "recipient",
            "to": "problem-reported",
            "order": 2,
            "emphasis": "destructive",
            "updates": [
              {
                "kind": "copy-input",
                "output": "problem-details",
                "input": "problem-details"
              }
            ]
          }
        ],
        "payload": [
          {
            "id": "problem-details",
            "name": "Problem Details",
            "domainField": "problem-details"
          }
        ]
      },
      {
        "id": "set-tracking-link",
        "name": "Add or Update Tracking Link",
        "payload": [
          {
            "id": "tracking-link",
            "name": "Tracking Link",
            "domainField": "tracking-link"
          }
        ],
        "paths": [
          {
            "id": "set-tracking-link-awaiting-collection",
            "from": "awaiting-collection",
            "role": "sender",
            "to": "awaiting-collection",
            "order": 10,
            "updates": [
              {
                "kind": "copy-input",
                "output": "tracking-link",
                "input": "tracking-link"
              }
            ]
          },
          {
            "id": "set-tracking-link-in-transit",
            "from": "in-transit",
            "role": "sender",
            "to": "in-transit",
            "order": 10,
            "updates": [
              {
                "kind": "copy-input",
                "output": "tracking-link",
                "input": "tracking-link"
              }
            ]
          },
          {
            "id": "set-tracking-link-delivered",
            "from": "delivered",
            "role": "sender",
            "to": "delivered",
            "order": 10,
            "updates": [
              {
                "kind": "copy-input",
                "output": "tracking-link",
                "input": "tracking-link"
              }
            ]
          }
        ]
      }
    ],
    "presentation": {
      "workflowData": {
        "prominentFields": [
          "parcel",
          "tracking-link"
        ]
      }
    }
  }
}
